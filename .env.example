# Supabase Public & Private Configuration
NEXT_PUBLIC_APP_NAME="AI API"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_GATEWAY_BASE_URL="http://localhost:8787"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Gateway Internal Token for Playground bridge
GATEWAY_INTERNAL_TOKEN="your-secure-internal-admin-token"
GATEWAY_USER_ASSERTION_SECRET="your-dedicated-playground-assertion-secret"

# Upstream AI Provider API Keys
A6API_BASE_URL="https://api.a6api.com/v1"
A6API_KEY="your-a6api-key"
NECO_BASE_URL="https://api.neco.com/v1"
NECO_KEY="your-neco-key"

# Payment Webhook Secret (legacy/external webhook validation)
PAYMENT_WEBHOOK_SECRET="your-payment-webhook-secret"

# MB Bank poller integration. BANK_POLLER_SECRET is shared with the VPS worker.
# MB login credentials MUST NOT be placed in this web environment; they belong
# only in services/mb-poller/.env on the VPS.
BANK_POLLER_SECRET="generate-a-long-random-secret"
BANK_PAYMENT_PROVIDER="mb_poller"
NEXT_PUBLIC_BANK_ID="MB"
NEXT_PUBLIC_BANK_NAME="Ngân hàng TMCP Quân đội (MB)"
NEXT_PUBLIC_BANK_ACCOUNT_NO="your-mb-receiving-account-number"
NEXT_PUBLIC_BANK_ACCOUNT_NAME="YOUR ACCOUNT NAME"

# Admin Configuration
ADMIN_EMAILS="admin@example.com"
