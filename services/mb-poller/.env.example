# MB credentials stay ONLY on the VPS running this service.
MB_USERNAME="your-mb-login"
MB_PASSWORD="your-mb-password"
MB_ACCOUNT_NUMBER="your-dedicated-mb-receiving-account"
MB_OCR_METHOD="default"

# APIVN web application and shared server-to-server secret.
APIVN_BASE_URL="https://apivn.tech"
BANK_POLLER_SECRET="generate-a-long-random-secret"

# Hard lower bounds are enforced by the service.
POLL_INTERVAL_MS="60000"
STATE_CHECK_INTERVAL_MS="15000"
